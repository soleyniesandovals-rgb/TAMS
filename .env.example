# Copia este archivo a .env y cambia los valores de ejemplo.
# .env no se versiona (git check-ignore -v .env).

# Contraseña de "sa" para SQL Server. El ejemplo cumple la complejidad de SQL
# Server y no contiene $, ; ni comillas. Cámbialo en tu .env.
MSSQL_SA_PASSWORD=TamsDemo2026!

# Secreto JWT de EJEMPLO: Base64 de 32 bytes (256 bits). Genera uno propio
# para tu .env; este valor solo sirve como plantilla.
TAMS_JWT_SECRETO=EHwMuQcnUBZBWcLRhHSphDXA4lNieb2TPMY3JC4ddSE=

# Modo sin SMTP: deja TAMS_SMTP_HOST vacío. El procesador de correos escribirá
# el destinatario, el asunto y el cuerpo (con el enlace) en el log.
# Los correos se leen con: docker compose logs correos
TAMS_SMTP_HOST=
TAMS_SMTP_PORT=
TAMS_SMTP_USUARIO=
TAMS_SMTP_CONTRASENA=
TAMS_SMTP_REMITENTE=

# Clave gratuita de calendarific.com/register. Sin ella, el cálculo de días
# lectivos (/api/anios-escolares/{id}/dias-lectivos) responde 503 y el resto
# del sistema sigue funcionando.
TAMS_API_FERIADOS_CLAVE=
